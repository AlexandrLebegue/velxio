  "name": "Hello World - ESP32 e-paper 2.9 inch",
  "boards": [
    {
      "id": "esp32",
      "name": "ESP32 Hello e-paper",
      "boardKind": "esp32",
      "x": 120,
      "y": 80,
      "activeFileGroupId": "group-hello-epaper-esp32",
      "languageMode": "arduino",
