      "libraries": [
        "GxEPD2",
        "Adafruit GFX Library",
        "Adafruit BusIO"
      ]
    }
  ],
  "fileGroups": {
    "group-hello-epaper-esp32": [
      {
        "name": "sketch.ino",
        "content": "// ESP32 + catalogue panel epaper-2in9-bw (296x128 SSD1680).\n// Driver and init follow frontend/src/data/examples-displays-epaper.ts,\n// weatherEsp29. Display output still requires the manager's real build/run.\n// SPI: SCK=18, MOSI=23; CS=5, DC=17, RST=16, BUSY=4.\n#include <Arduino.h>\n#include <SPI.h>\n#include <Adafruit_GFX.h>\n#include <GxEPD2_BW.h>\n\nGxEPD2_BW<GxEPD2_290_T94, GxEPD2_290_T94::HEIGHT> display(\n  GxEPD2_290_T94(/*CS=*/5, /*DC=*/17, /*RST=*/16, /*BUSY=*/4));\n\nvoid setup() {\n  Serial.begin(115200);\n  SPI.begin(/*SCK=*/18, /*MISO unused=*/-1, /*MOSI=*/23, /*SS=*/5);\n  display.init(115200, true, 50, false);\n  display.setRotation(1);\n  display.setTextColor(GxEPD_BLACK);\n  display.setTextSize(2);\n  display.setFullWindow();\n  display.firstPage();\n  do {\n    display.fillScreen(GxEPD_WHITE);\n    display.setCursor(20, 40);\n    display.print(\"Hello World\");\n  } while (display.nextPage());\n  display.hibernate();\n  Serial.println(\"Hello World frame sent\");\n}\n\nvoid loop() {\n  delay(1000);\n}\n"
      }
    ]
  },
